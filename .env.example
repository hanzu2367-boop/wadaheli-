# Copy this to .env and replace the values with your real ones.
# This is the fix for the Vercel AI Gateway 401 issue.

VERCEL_API_KEY=your_vercel_api_key_here
AI_GATEWAY_API_KEY=your_vercel_api_key_here

# Keep this as a plain model unless you are sure the custom gateway is valid.
MODEL=gpt-4.1-mini

# If you are using a custom gateway model, make sure it exists in your Vercel AI Gateway.
# Otherwise leave it empty to avoid the fallback loop.
CUSTOM_MODEL=
FALLBACK_MODEL=

# Optional debugging
LITELLM_LOG_LEVEL=ERROR
